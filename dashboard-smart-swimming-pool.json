      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "description": "Switching times of the filter (pool) pump and the solar pump.",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT last(\"state\") FROM \"switch.$pool_pump\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series",
          "alias": "Pool Pump"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
